# Environment Configuration Example
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# API URLs
NEXT_PUBLIC_API_URL=http://localhost:4000
WEBHOOK_BASE_URL=http://localhost:4000/webhooks

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/webhook_platform?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets
JWT_SECRET=super-secret-access-token-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=super-secret-refresh-token-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AES-256-GCM Master Encryption Key (32 bytes / 64 hex characters)
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# CORS Allowlist
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# Feature Flags
POLLING_ENABLED=true
TELEGRAM_ENABLED=true
EMAIL_ENABLED=true
BILLING_ENABLED=true
DEMO_MODE_ENABLED=true

# SMTP Email Configuration (Optional / Sandbox)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=sandbox_user
SMTP_PASS=sandbox_pass
SMTP_FROM="Webhook Automation Platform <noreply@webhookplatform.io>"

# Telegram Bot Token (Optional / Sandbox)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz1234567

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
